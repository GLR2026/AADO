# AADO Git text normalization

# Default: normalize text in repository
* text=auto

# Documentation / configuration: canonical LF
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Windows scripts
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Linux / shell scripts
*.sh   text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.pdf  binary
*.docx binary
