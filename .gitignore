# ============================================================
# AADO .gitignore
# ============================================================

# Secrets / environment
.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.crt

credentials/
secrets/

# Runtime / private state
.aado/
runtime/
state/
logs/
outbox/
tmp/
temp/
dumps/
backups/

# Dumps / databases
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# Logs
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Windows / OS
Thumbs.db
desktop.ini
.DS_Store

# Browser / tests
playwright-report/
test-results/
coverage/

# Temporary files
*.tmp
*.temp
